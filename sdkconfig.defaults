# Target and installed flash capacity.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The bring-up Tab5 has ESP32-P4 revision v1.3.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# M5GFX 0.2.34 Tab5 display initialization requires >80 MHz and requests 200 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# LGFX_PPA uses the existing managed M5GFX dependency.
CONFIG_LGFX_PPA_USE_GFX=y
# CONFIG_LGFX_PPA_USE_LOVYANGFX is not set
CONFIG_LGFX_PPA_USE_M5GFX=y
# Keep firmware code in flash rather than copying it into PSRAM.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# Keep startup logs and panic output on the USB Serial/JTAG console.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=120

# Collect per-task runtime in microseconds for debugging and CPU load sampling.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Keep presentation on core 0 so it can overlap with Lua drawing on core 1.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Shared SD card filesystem and USB file transfer.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_FS_LOCK=32
CONFIG_TINYUSB_MTP_ENABLED=y
# CONFIG_TINYUSB_CDC_ENABLED is not set

# Lua
CONFIG_LUA_USE_PSRAM=y
