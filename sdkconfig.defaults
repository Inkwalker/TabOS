# Target and installed flash capacity.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The bring-up Tab5 has ESP32-P4 revision v1.3.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# M5GFX 0.2.34 Tab5 display initialization requires >80 MHz and requests 200 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep firmware code in flash rather than copying it into PSRAM.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Keep presentation on core 1 so it can overlap with Lua drawing on core 0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
